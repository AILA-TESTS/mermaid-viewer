    INTERP & ANIM_CODE & PROP_FIXES --> GEN_SCENES
    REVIDEO_RENDER --> MP4

    %% State persistence (dashed = non-blocking)
    STATE_MGR -.->|"resumable state\nload on startup"| ORCH
    S1_NODE -.->|"hierarchy.json saved"| STATE_MGR
    STAGE2_OUT -.->|"storyboard.json saved"| STATE_MGR
    STAGE5_OUT -.->|"visual_mapping.json saved"| STATE_MGR
    TTS_RESULT_NODE -.->|"tts_results.json saved"| STATE_MGR
    SCAFFOLD_OP -.->|"projectPath saved"| STATE_MGR

    %% GCP infrastructure flow
    REVIDEO_RENDER -->|"output.mp4"| GCS_UPLOAD
    PUBSUB -->|"trigger execution"| CR_JOB
    CR_JOB -->|"runs container"| WORKER_JS
    WORKER_JS -->|"downloads state + audio"| GCS_BUCKETS
    WORKER_JS -->|"uploads mp4"| GCS_BUCKETS
    CLOUD_BUILD -->|"push Docker image"| ARTIFACT_REG
    ARTIFACT_REG -->|"pull Docker image"| CR_JOB

    %% Template reference
    BASE_SCENE -.->|"reference pattern\nfor generated scenes"| INTERP

