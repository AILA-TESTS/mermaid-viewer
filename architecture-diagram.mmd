        VA_LLM["llm.chat(messages, {temp:0.7, responseFormat:json})\nRaw LLM JSON output string"]
        NORMALIZE["normalizeRawScene() — normalize.ts\n---\n1. Propagate parent region to\n   children missing region\n2. Expand array timeline targets\n   into separate timeline blocks\n3. Map aliases:\n   Fade and FadeInUp to FadeIn"]
        ZOD_VALIDATE["VisualSceneSchema.safeParse()\n---\nStructural checks:\nsceneId, sceneType, narration, audioKey\nelements[]: VisualElementSchema\n  id, type: Rect/Circle/Txt/Line/Polygon/Latex/Img/Node\n  props: Record string unknown\n  region: TITLE/BOOK_TEXT_PANEL/etc (required top-level)\n  children?: ChildVisualElementSchema (region optional)\ntimeline[]: TimelineBlockSchema\n  target: coerce array to first element\n  action: FadeIn/FadeOut/Create/Write/GrowFromCenter/\n          DrawBorderThenFill/GrowArrow/MoveBy/ScaleTo/\n          ColorChange/LaggedStart\n  startTime >= 0, duration > 0"]
        SEM_VALIDATE["validateMapping() semantic checks:\nUnique element IDs per scene\nTimeline targets reference valid IDs\nPositions within canvas bounds\nNo overlapping sibling bboxes\nNo forbidden colors: transparent/#2c3e2c/#000000\nRichness: >= 8 elements, >= 5 timeline blocks\n         >= 3 animation types"]

